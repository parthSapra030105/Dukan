# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice provider switch — 'bolna' | 'vapi' | 'custom'
VOICE_PROVIDER=bolna

# Bolna — required when VOICE_PROVIDER=bolna
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Bolna does NOT sign webhooks (per their public docs).
# Security = source-IP allowlist for /api/voice/webhook. 13.203.39.153 is their published webhook origin.
# Comma-separated list of allowed IPs. Leave empty in dev to skip the check (NOT for prod).
BOLNA_WEBHOOK_ALLOWED_IPS=13.203.39.153
# Public base URL for tool callbacks (must be Bolna-reachable; use ngrok/Vercel preview in dev)
BOLNA_WEBHOOK_PUBLIC_URL=

# Shared secret sent as `x-dukan-tool-secret` on every agent tool call.
# Bolna's tool runtime calls from shifting IPs, so we authenticate with this header
# instead of an IP allowlist. Generate with: openssl rand -hex 32
# Sync this value to Bolna (run `bun run scripts/patch-tool-headers.ts`) AND to Vercel env.
TOOL_SHARED_SECRET=

# Vapi — required when VOICE_PROVIDER=vapi (stub, not implemented for v1)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=

# Custom stack — required when VOICE_PROVIDER=custom (stub, not implemented for v1)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
